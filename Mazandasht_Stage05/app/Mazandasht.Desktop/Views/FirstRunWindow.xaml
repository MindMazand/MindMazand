<Window x:Class="Mazandasht.Desktop.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="راه‌اندازی اولیه مازندشت" Width="560" Height="650"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FlowDirection="RightToLeft" Background="#0B1711">
    <Grid Margin="28">
        <Border Background="#E61A2B20" BorderBrush="#55FFFFFF" BorderThickness="1"
                CornerRadius="24" Padding="30">
            <StackPanel>
                <Image Source="pack://application:,,,/Assets/mazandasht-logo.png" Height="105" Stretch="Uniform" Margin="0,0,0,14"/>
                <TextBlock Text="راه‌اندازی مدیر اصلی" FontSize="24" FontWeight="Bold" Margin="0,4,0,8"/>
                <TextBlock Text="برای امنیت، هیچ نام کاربری یا گذرواژه پیش‌فرضی در برنامه وجود ندارد."
                           Foreground="#B9C9BE" TextWrapping="Wrap" Margin="0,0,0,22"/>
                <TextBlock Text="نام نمایشی" Margin="0,0,0,6"/>
                <TextBox x:Name="DisplayNameBox" Height="42" Padding="10" FontSize="14"
                         Background="#1FFFFFFF" Foreground="#FFFFFF" BorderBrush="#55FFFFFF"/>
                <TextBlock Text="نام کاربری" Margin="0,16,0,6"/>
                <TextBox x:Name="UsernameBox" Height="42" Padding="10" FontSize="14"
                         Background="#1FFFFFFF" Foreground="#FFFFFF" BorderBrush="#55FFFFFF"/>
                <TextBlock Text="گذرواژه (حداقل ۱۲ نویسه)" Margin="0,16,0,6"/>
                <PasswordBox x:Name="PasswordBox" Height="42" Padding="10" FontSize="14"
                             Background="#1FFFFFFF" Foreground="#FFFFFF" BorderBrush="#55FFFFFF"/>
                <TextBlock Text="تکرار گذرواژه" Margin="0,16,0,6"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Height="42" Padding="10" FontSize="14"
                             Background="#1FFFFFFF" Foreground="#FFFFFF" BorderBrush="#55FFFFFF"/>
                <Button Content="ایجاد مدیر اصلی و ورود" Style="{StaticResource GlassButton}"
                        Background="#FC6E05" BorderBrush="#FC6E05" FontWeight="Bold"
                        Height="48" Margin="0,24,0,0" Click="CreateAdmin_Click"/>
                <TextBlock x:Name="ErrorText" Foreground="#FFB6A6" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>