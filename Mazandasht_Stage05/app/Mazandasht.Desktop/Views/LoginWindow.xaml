<Window x:Class="Mazandasht.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ورود به مازندشت" Width="500" Height="510"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FlowDirection="RightToLeft" Background="#0B1711">
    <Grid Margin="28">
        <Border Background="#E61A2B20" BorderBrush="#55FFFFFF" BorderThickness="1"
                CornerRadius="24" Padding="30">
            <StackPanel VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/mazandasht-logo.png" Height="110" Stretch="Uniform" Margin="0,0,0,20"/>
                <TextBlock Text="ورود به سامانه مدیریت مازندشت" FontSize="21" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="محیط عملیاتی آفلاین و پایگاه داده محلی"
                           Foreground="#B9C9BE" Margin="0,0,0,22"/>
                <TextBlock Text="نام کاربری" Margin="0,0,0,6"/>
                <TextBox x:Name="UsernameBox" Height="44" Padding="10" FontSize="14"
                         Background="#1FFFFFFF" Foreground="#FFFFFF" BorderBrush="#55FFFFFF"/>
                <TextBlock Text="گذرواژه" Margin="0,16,0,6"/>
                <PasswordBox x:Name="PasswordBox" Height="44" Padding="10" FontSize="14"
                             Background="#1FFFFFFF" Foreground="#FFFFFF" BorderBrush="#55FFFFFF"
                             KeyDown="PasswordBox_KeyDown"/>
                <Button Content="ورود" Style="{StaticResource GlassButton}"
                        Background="#FC6E05" BorderBrush="#FC6E05" FontWeight="Bold"
                        Height="48" Margin="0,24,0,0" Click="Login_Click"/>
                <TextBlock x:Name="ErrorText" Foreground="#FFB6A6" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>