<Window x:Class="Mazandasht.Desktop.Views.ImportReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مرکز ورود اطلاعات" Width="1180" Height="760" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        Background="#0B1711" Foreground="#F2F7F3">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="مرکز ورود و بازبینی اطلاعات" FontSize="23" FontWeight="Bold"/>
            <TextBlock Text="برای هر ماژول فایل Excel یا CSV انتخاب کنید؛ ابتدا شیت/جدول، ستون‌ها و ردیف‌ها پیش‌نمایش و نگاشت می‌شوند. ذخیره صف بررسی جدا از ثبت قطعی در دفاتر عملیاتی است."
                       Foreground="#A9B9AE" FontSize="12" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="نوع اطلاعات / ماژول مقصد" Foreground="#A9B9AE" FontSize="10" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ProfileCombo" Height="38" DisplayMemberPath="DisplayName" SelectedValuePath="Code"/>
                </StackPanel>
                <TextBlock x:Name="ProfileDescriptionText" Grid.Column="1" Text="قالب استاندارد ماژول را انتخاب کنید." TextWrapping="Wrap"
                           VerticalAlignment="Center" Foreground="#A9B9AE" Margin="8,0,8,0"/>
                <Button x:Name="TemplateButton" Grid.Column="2" Content="دریافت قالب Excel" Style="{StaticResource GlassButton}"
                        Height="38" MinWidth="145" Click="Template_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.3*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="فایل منبع (Excel / CSV)" Foreground="#A9B9AE" FontSize="10" Margin="0,0,0,5"/>
                    <TextBox x:Name="FilePathBox" Height="38" IsReadOnly="True" VerticalContentAlignment="Center"
                             Background="#222F29" Foreground="#F2F7F3" BorderBrush="#496254" Padding="10,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="شیت مورد بررسی" Foreground="#A9B9AE" FontSize="10" Margin="0,0,0,5"/>
                    <ComboBox x:Name="SheetCombo" Height="38" IsEnabled="False" SelectionChanged="SheetCombo_SelectionChanged"/>
                </StackPanel>
                <Button Grid.Column="2" Content="انتخاب فایل" Style="{StaticResource GlassButton}" Height="38" MinWidth="105"
                        Margin="0,17,8,0" Click="Browse_Click"/>
                <Button x:Name="LoadButton" Grid.Column="3" Content="خواندن و پیش‌نمایش" Style="{StaticResource AccentButton}"
                        Height="38" MinWidth="150" Margin="0,17,0,0" Click="Load_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="155"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,12">
                <Border Style="{StaticResource GlassCard}" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="نام فایل" Foreground="#A9B9AE" FontSize="10"/><TextBlock x:Name="FileNameText" Text="—" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="ردیف‌های غیرخالی" Foreground="#A9B9AE" FontSize="10"/><TextBlock x:Name="RowsCountText" Text="—" FontSize="19" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="ستون‌های قابل خواندن" Foreground="#A9B9AE" FontSize="10"/><TextBlock x:Name="ColumnsCountText" Text="—" FontSize="19" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource GlassCard}">
                    <StackPanel><TextBlock Text="اثر انگشت SHA-256" Foreground="#A9B9AE" FontSize="10"/><TextBlock x:Name="HashText" Text="—" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="8" Margin="0,0,0,10">
                <DataGrid x:Name="MappingGrid" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#122019"
                          Foreground="#F2F7F3" RowBackground="#192A20" AlternatingRowBackground="#203329"
                          BorderThickness="0" HorizontalGridLinesBrush="#31513D" VerticalGridLinesBrush="#31513D"/>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="8">
                <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#122019"
                          Foreground="#F2F7F3" RowBackground="#192A20" AlternatingRowBackground="#203329"
                          BorderThickness="0" HorizontalGridLinesBrush="#31513D" VerticalGridLinesBrush="#31513D"
                          SelectionUnit="FullRow" EnableRowVirtualization="True" EnableColumnVirtualization="True"/>
            </Border>
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Text="برای شروع، فایل Excel را انتخاب کنید." Foreground="#A9B9AE"
                       VerticalAlignment="Center" DockPanel.Dock="Right"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="بستن" Style="{StaticResource GlassButton}" Width="90" Margin="0,0,8,0" Click="Close_Click"/>
                <Button x:Name="StageButton" Content="ذخیره در صف بررسی" Style="{StaticResource AccentButton}" Width="170"
                        IsEnabled="False" Click="Stage_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
