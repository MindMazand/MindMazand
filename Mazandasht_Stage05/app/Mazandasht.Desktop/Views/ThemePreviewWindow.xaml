<Window x:Class="Mazandasht.Desktop.Views.ThemePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="انتخاب تم رابط کاربری" Height="430" Width="620"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Vazirmatn, Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="تم رابط کاربری" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="تم انتخاب‌شده برای کل نرم‌افزار اعمال و در تنظیمات ذخیره می‌شود."
                       FontSize="12" Margin="0,6,0,0"
                       Foreground="{DynamicResource MutedTextBrush}"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,16,0,0" x:Name="ThemeList"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="ApplyButton" Content="اعمال تم" Style="{StaticResource AccentButton}"
                    Width="120" Click="ApplyButton_Click"/>
            <Button x:Name="CancelButton" Content="انصراف" Style="{StaticResource GlassButton}"
                    Margin="10,0,0,0" Width="110" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
