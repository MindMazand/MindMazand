*.cache

# Local database and WAL
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal

# Connector download staging
google_drive/

# Private / operational data
sources/
Backups/
Exports/
Imports/
Logs/
*.key
*.pfx
*.pem
*.secrets
